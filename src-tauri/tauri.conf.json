{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Projekt",
  "version": "0.1.0",
  "identifier": "app.projekt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Projekt",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "TheMarlou",
    "copyright": "© 2026 TheMarlou",
    "category": "Productivity",
    "shortDescription": "Brainstorming pour créateurs de jeux vidéo — notes, moodboard, carte mentale, IA locale.",
    "longDescription": "Projekt réunit dans une seule fenêtre les notes d’un projet de jeu vidéo, un moodboard d’images et de vidéos, et une carte mentale qui relie les pages entre elles. Un assistant fonctionne entièrement sur votre ordinateur, sans compte ni abonnement : vos idées ne quittent jamais votre machine.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
